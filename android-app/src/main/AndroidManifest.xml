<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.CAMERA"/><uses-permission android:name="android.permission.WAKE_LOCK"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/><uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
 <application android:theme="@style/Theme.WiredCam" android:label="WiredCam" android:allowBackup="false" android:usesCleartextTraffic="true">
  <activity android:name=".MainActivity" android:screenOrientation="fullSensor" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <service android:name=".StreamService" android:foregroundServiceType="camera" android:exported="false"/>
 </application>
</manifest>
